    <string name="video_super_resolution_mode_a">Mod A</string>
    <string name="video_super_resolution_mode_a_desc">Artılar: Sıkıştırma artefaktlarını azaltır, çizgileri yeniden oluşturur, bulanıklığı ve gürültüyü azaltır.\nEksiler: Halkalanmayı, bant oluşumunu ve doku bulanıklığını güçlendirebilir.</string>
    <string name="video_super_resolution_mode_b">Mod B</string>
    <string name="video_super_resolution_mode_b_desc">Artılar: Sıkıştırma artefaktlarını azaltır, çizgileri kısmen yeniden oluşturur, bulanıklığı kısmen azaltır, halkalanmayı, basamaklanmayı ve gürültüyü azaltır.\nEksiler: Bazı artefaktlar giderilemeyebilir, bazı çizgiler hâlâ bulanık olabilir, dokuları bulanıklaştırır.</string>
    <string name="video_super_resolution_mode_c">Mod C</string>
    <string name="video_super_resolution_mode_c_desc">Artılar: Gürültüyü azaltır.\nEksiler: Mevcut halkalanma ve yeniden örnekleme artefaktlarını güçlendirir.</string>
    <string name="video_super_resolution_mode_aa">Mod A+A</string>
    <string name="video_super_resolution_mode_aa_desc">Artılar: Geliştirilmiş Mod A etkisi.\nEksiler: Mod A’dan daha yavaş, ciddi halkalanma, bant oluşumu ve basamaklanma oluşturabilir.</string>
    <string name="video_super_resolution_mode_bb">Mod B+B</string>
    <string name="video_super_resolution_mode_bb_desc">Artılar: Geliştirilmiş Mod B etkisi.\nEksiler: Mod B ile aynı, Mod B’den daha yavaş.</string>
    <string name="video_super_resolution_mode_ca">Mod C+A</string>
    <string name="video_super_resolution_mode_ca_desc">Artılar: Geliştirilmiş Mod C etkisi.\nEksiler: Mod C ile aynı, Mod C’den daha yavaş.</string>
